<Project>

    <PropertyGroup>
        <Authors>DbBump Contributors</Authors>
        <PackageReleaseNotes>https://github.com/DbBump/DbBump/releases</PackageReleaseNotes>
        <PackageProjectUrl>https://github.com/DbBump/DbBump</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>dbbump-icon.png</PackageIcon>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
</Project>
